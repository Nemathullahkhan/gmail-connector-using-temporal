# Google OAuth (Web client). Redirect URI to register: http://localhost:53682/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_USER=you@yourdomain.com
# Filled in by `npm run auth`
GOOGLE_REFRESH_TOKEN=
# Sending is off unless this is true
ALLOW_SEND=false
# Postgres from docker-compose.yml
DATABASE_URL=postgres://mailconn:mailconn_dev@localhost:5432/mailconn
TEMPORAL_ADDRESS=localhost:7233
POSTGRES_PORT=5432
# gmail (default) or mailpit (local test server, see README)
MAIL_PROVIDER=gmail
# Only used when MAIL_PROVIDER=mailpit
MAILPIT_URL=http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
FROM_ADDRESS=connector@example.com
