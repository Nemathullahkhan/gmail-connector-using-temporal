{
  "name": "mail-connector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env -r ts-node/register src/worker.ts",
    "auth": "node --env-file-if-exists=.env -r ts-node/register src/auth.ts",
    "migrate": "node --env-file-if-exists=.env -r ts-node/register src/migrate.ts",
    "client": "node --env-file-if-exists=.env -r ts-node/register src/client.ts",
    "test": "mocha --exit --timeout 60000 --require ts-node/register 'src/mocha/*.test.ts'"
  },
  "dependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "googleapis": "^185.0.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.24.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "mocha": "^12.0.3",
    "ts-node": "^10.9.2",
    "typescript": "5.9"
  }
}
